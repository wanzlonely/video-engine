# URL worker render terpisah (VM/Cloud Run/queue) yang menjalankan
# render.js dari repo video-engine. Worker ini HARUS menyediakan:
#   POST {RENDER_WORKER_URL}/jobs        -> { jobId, naskah }  => { jobId, status }
#   GET  {RENDER_WORKER_URL}/jobs/:jobId -> { status, progress?, outputUrl?, error? }
RENDER_WORKER_URL=https://render-worker.contoh-domain.com
RENDER_WORKER_TOKEN=ganti-dengan-secret-worker
